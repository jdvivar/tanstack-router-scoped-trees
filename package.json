{
  "name": "tanstack-router-scoped-trees",
  "version": "0.0.0",
  "description": "Generate per-section TanStack Router route trees for faster tests. A community package, not an official TanStack package.",
  "license": "MIT",
  "author": "Daniel Vivar",
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "bin": {
    "tanstack-router-scoped-trees": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "peerDependencies": {
    "@tanstack/router-generator": ">=1.167.0 <2",
    "@tanstack/virtual-file-routes": ">=1.162.0 <2",
    "vite": "8.3.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "cac": "^7.1.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/node": "^22.20.5",
    "eslint": "10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
